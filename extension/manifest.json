{
  "manifest_version": 3,
  "name": "IGmetryx Feed Snapshot",
  "version": "1.0.0",
  "description": "Capture full Instagram feed screenshots automatically. Client-side only, no server access.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*", "https://instagram.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://localhost/*", "https://*.igmetryx.com/*"],
      "js": ["web-app-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "IGmetryx Feed Snapshot"
  },
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

